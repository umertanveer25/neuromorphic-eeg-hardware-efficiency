\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Bio-Thermal Cortical Tissue Dissipation and Implant Battery Replacement Lifespan Analysis.} Panel A plots cortical tissue temperature rise ($\Delta T$, $^\circ \text  {C}$) over 24 hours of continuous EEG monitoring, comparing conventional deep neural networks against our sub-microwatt pipeline under the ISO 14708-3 necrosis cap ($1.0\,^\circ \text  {C}$). Panel B compares expected surgical battery replacement intervals in years.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig5}{{5}{11}{\textbf {Bio-Thermal Cortical Tissue Dissipation and Implant Battery Replacement Lifespan Analysis.} Panel A plots cortical tissue temperature rise ($\Delta T$, $^\circ \text {C}$) over 24 hours of continuous EEG monitoring, comparing conventional deep neural networks against our sub-microwatt pipeline under the ISO 14708-3 necrosis cap ($1.0\,^\circ \text {C}$). Panel B compares expected surgical battery replacement intervals in years}{figure.caption.10}{}}
